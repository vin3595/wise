[Unit]
Description=Wise Box (restaurant billing)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/wise start
ExecStop=/usr/local/bin/wise stop
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
